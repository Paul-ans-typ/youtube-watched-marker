{
  "manifest_version": 3,
  "name": "YouTube Watched Marker",
  "version": "1.3.0",
  "description": "Marks videos you've already watched using a watch history imported from Google Takeout.",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-watched-marker@paul-ans-typ.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "YouTube Watched Marker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["account-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
